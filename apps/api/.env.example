# Optional legacy integration; disabled unless SANAD_ENABLE_REMOTE_SEMANTIC=true
OPENAI_API_KEY=
OPENAI_MODEL=

# Live web discovery
BRAVE_SEARCH_API_KEY=

# Temporary curated-secondary hadith search provider
HADITH_API_KEY=

# Official Sunnah.com API
SUNNAH_API_KEY=

# Official Quran Foundation backend OAuth client (never expose to browser code)
QURAN_FOUNDATION_CLIENT_ID=
QURAN_FOUNDATION_CLIENT_SECRET=
# New developer apps normally start in prelive; switch only with approved
# production credentials.
QURAN_FOUNDATION_ENV=prelive

# Public/keyless knowledge providers. OPENALEX_API_KEY is optional; keyless
# basic mode remains available. CROSSREF_MAILTO is optional but recommended by
# Crossref for polite-pool identification.
WIKIPEDIA_LANGS=id,en
OPENALEX_API_KEY=
CROSSREF_MAILTO=
CROSSREF_USER_AGENT=SANAD.AI/0.2

# Runtime
SANAD_HTTP_TIMEOUT=12
SANAD_MAX_WEB_RESULTS=10
SANAD_HADITH_API_PAGE_SIZE=25
SANAD_QURAN_MAX_RESULTS=5
SANAD_SCHOLARLY_MAX_RESULTS=5
SANAD_MAX_BRAVE_REQUESTS=2
SANAD_MAX_WEB_PAGES=3
SANAD_WEB_CACHE_TTL_SECONDS=900
SANAD_KNOWLEDGE_CACHE_TTL_SECONDS=3600
SANAD_WEB_MAX_CONTENT_BYTES=750000
SANAD_ENABLE_BROAD_WEB_DISCOVERY=true
SANAD_ENABLE_HISTORY_ACADEMIC_RETRIEVAL=true
SANAD_ENABLE_REMOTE_SEMANTIC=false
SANAD_ENABLE_SEMANTIC_RERANK=false
SANAD_SEMANTIC_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
